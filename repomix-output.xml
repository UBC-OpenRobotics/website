  {% include divider.html %}

  <section class="bg-white dark:bg-gray-800 flex items-center justify-center py-16">
    <div class="container mx-auto px-4">
      
      <div class="flex flex-col md:flex-row items-center gap-16 max-w-7xl mx-auto">
        <div class="md:w-1/2">
          <img src="{{ '/assets/images/team/team-photo.jpg' | relative_url }}"
               alt="Open Robotics Team"
               class="rounded-lg shadow-lg w-full h-auto object-cover">
        </div>
        <div class="md:w-1/2">
          <h2 class="text-5xl font-semibold text-gray-800 dark:text-gray-100 mb-4 text-left">Our team</h2>
          <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
            {{ page.team-description }}
          </p>
          {%- if page.team-description-2 -%}
          <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed mt-4">
            {{ page.team-description-2 }}
          </p>
          {%- endif -%}
          <button class="mt-6 md:text-xl border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white font-bold py-4 px-8 rounded-lg transition-colors tracking-wide">
            <a href="/join">JOIN OUR TEAM</a>
          </button>
        </div>
      </div>
    </div>
  </section>

  {% include divider.html %}

  {%- assign all_projects = site.projects | sort: "order" -%}
  {%- assign sorted_projects = all_projects | where_exp: "item", "item.layout == 'project-main'" -%}
  {%- assign total_projects = sorted_projects | size -%}
  {%- assign slides_count = total_projects | divided_by: 3.0 | ceil -%}

  <!-- PROJECT SHOWCASE -->

  <section class="bg-gray-100 dark:bg-gray-900 flex items-center justify-center py-16">
    <div class="container mx-auto px-4">

      <!-- Project text and desc -->
      <div class="flex flex-col md:flex-row items-left gap-16 max-w-7xl mx-auto">
        <div class="md:w-1/2">
          <h2 class="text-5xl font-semibold text-gray-800 dark:text-gray-100 text-left">Projects. Systems. Solutions.</h2>
        </div>
        <div class="md:w-1/2">
          <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
            {{ page.projects-section-description }}
          </p>
        </div>
      </div>

      <div class="h-16 transparent"></div>

      <!-- Carousel Container -->
      <div class="relative max-w-7xl mx-auto">
        <div class="carousel-container overflow-hidden px-4 md:px-0">
          <!-- Desktop: 3 cards per slide -->
          <div class="carousel-track-desktop hidden md:flex transition-transform duration-500 ease-in-out">
            {%- for i in (0..slides_count) -%}
              {%- assign slide_index = i | times: 3 -%}
              {%- assign slide_projects = sorted_projects | slice: slide_index, 3 -%}

              {%- if slide_projects.size > 0 -%}
              <!-- Desktop Slide {{ i }} -->
              <div class="carousel-slide-desktop min-w-full flex gap-6">
                {%- for project in slide_projects -%}
                <div class="flex-1 min-w-0">
                  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden h-full">
                    <img src="{{ project.thumbnail | relative_url }}"
                         alt="{{ project.title }}"
                         class="w-full h-48 object-cover">
                    <div class="p-4">
                      <a href="{{ project.url | relative_url }}"
                         class="text-xl mb-2 font-semibold text-gray-800 dark:text-gray-100 hover:text-red-600 dark:hover:text-red-500 transition-colors block">
                        {{ project.title }}
                      </a>

                      {% include project-status-badge.html %}

                      <p class="text-gray-600 dark:text-gray-300 mt-3 text-sm leading-relaxed line-clamp-3">
                        {%- if project.brief -%}
                          {{ project.brief }}
                        {%- else -%}
                          {{ project.description }}
                        {%- endif -%}
                      </p>
                    </div>
                  </div>
                </div>
                {%- endfor -%}

                {%- assign remaining = 3 | minus: slide_projects.size -%}
                {%- for j in (1..remaining) -%}
                <div class="flex-1 min-w-0 invisible">
                  <div class="bg-white rounded-lg shadow-lg overflow-hidden h-full">
                    <div class="w-full h-48"></div>
                    <div class="p-4">
                      <div class="h-6"></div>
                      <div class="h-16 mt-3"></div>
                    </div>
                  </div>
                </div>
                {%- endfor -%}
              </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <!-- Mobile: 1 card per slide -->
          <div class="carousel-track-mobile flex md:hidden transition-transform duration-500 ease-in-out">
            {%- for project in sorted_projects -%}
            <!-- Mobile Slide -->
            <div class="carousel-slide-mobile min-w-full px-2">
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden h-full max-w-sm mx-auto">
                <img src="{{ project.thumbnail | relative_url }}"
                     alt="{{ project.title }}"
                     class="w-full h-48 object-cover">
                <div class="p-4">
                  <a href="{{ project.url | relative_url }}"
                     class="text-xl font-semibold text-gray-800 dark:text-gray-100 hover:text-red-600 dark:hover:text-red-500 transition-colors block">
                    {{ project.title }}
                  </a>

                  {%- if project.status -%}
                  <div class="mt-2">
                    {%- case project.status -%}
                      {%- when "active" -%}
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                          <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                            <circle cx="10" cy="10" r="4"/>
                          </svg>
                          Active
                        </span>
                      {%- when "on hold" -%}
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200">
                          <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10 2a8 8 0 100 16 8 8 0 000-16zM9 9V5h2v4H9zm0 4v-2h2v2H9z"/>
                          </svg>
                          On Hold
                        </span>
                      {%- when "completed" -%}
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                          <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                          </svg>
                          Completed
                        </span>
                      {%- when "archived" -%}
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300">
                          <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8h8l-4 8z"/>
                          </svg>
                          Archived
                        </span>
                    {%- endcase -%}
                  </div>
                  {%- endif -%}

                  <p class="text-gray-600 dark:text-gray-300 mt-3 text-sm leading-relaxed line-clamp-3">
                    {{ project.description }}
                  </p>
                </div>
              </div>
            </div>
            {%- endfor -%}
          </div>
        </div>

        <!-- Navigation Arrows (hidden on mobile) -->
        {%- if slides_count > 1 -%}
        <button class="carousel-prev hidden md:block absolute -left-12 top-1/2 -translate-y-1/2 hover:text-red-600 dark:text-white text-gray-600 p-3 rounded-full transition-all">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <button class="carousel-next hidden md:block absolute -right-12 top-1/2 -translate-y-1/2 hover:text-red-600 dark:text-white text-gray-600 p-3 rounded-full transition-all">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>

        <!-- Carousel Indicators -->
        <!-- Desktop indicators -->
        <div class="hidden md:flex justify-center mt-6 gap-2">
          {%- for i in (0..slides_count) -%}
            {%- assign slide_index = i | times: 3 -%}
            {%- assign slide_projects = sorted_projects | slice: slide_index, 3 -%}
            {%- if slide_projects.size > 0 -%}
            <button class="carousel-indicator-desktop w-3 h-3 rounded-full bg-gray-400 hover:bg-gray-600 transition-all" data-index="{{ i }}"></button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <!-- Mobile indicators -->
        <div class="flex md:hidden justify-center mt-6 gap-2">
          {%- for project in sorted_projects -%}
          <button class="carousel-indicator-mobile w-3 h-3 rounded-full bg-gray-400 hover:bg-gray-600 transition-all" data-index="{{ forloop.index0 }}"></button>
          {%- endfor -%}
        </div>
        {%- endif -%}
      </div>

      <div class="h-8 transparent"></div>

      <!-- PROJECT BUTTONS -->
      <div class="flex flex-col md:flex-row items-center justify-center gap-8 max-w-7xl mx-auto">
        <button class="mt-4 md:text-xl border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white font-bold py-4 px-8 rounded-lg transition-colors tracking-wide">
          <a href="/projects">EXPLORE PROJECTS</a>
        </button>
      </div>
    </div>
  </section>

  <style>
    .carousel-indicator-desktop.active,
    .carousel-indicator-mobile.active {
      background-color: #DC2626;
      transform: scale(1.2);
    }
    .line-clamp-3 {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  </style>

  <!-- carousel javascript -->
  <script src="{{ '/assets/js/carousel.js' | relative_url }}"></script>

  <!-- ambient background javascript -->
  <script src="{{ '/assets/js/ambient-background.js' | relative_url }}"></script>


</div>
</file>

